{
  "name": "civil-affairs",
  "version": "1.0.0",
  "description": "Township civil administration and resident service portal",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node -r ./qr-management-server.js -r ./resident-services-server.js -r ./admin-applications-loader.js -r ./firebase-integration-server.js session-store-patch.js",
    "dev": "node -r ./qr-management-server.js -r ./resident-services-server.js -r ./admin-applications-loader.js -r ./firebase-integration-server.js --watch session-store-patch.js",
    "build": "node -e \"console.log('CAMS Firebase App Hosting build ready')\"",
    "test": "node tests/api-test.js"
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "better-sqlite3": "^11.8.1",
    "better-sqlite3-session-store": "^0.1.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0"
  }
}
