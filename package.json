{
  "name": "civil-affairs",
  "version": "1.0.0",
  "description": "Township civil administration and resident service portal",
  "main": "server.js",
  "engines": { "node": "22.23.2" },
  "scripts": {
    "start": "node -r ./qr-management-server.js -r ./resident-services-server.js -r ./admin-applications-loader.js -r ./firebase-integration-server.js -r ./firebase-all-routes.js -r ./firebase-route-priority.js -r ./firebase-qr-cutover.js -r ./cams-final-fixes.js -r ./resident-workforce-cutover.js -r ./resident-complaint-workforce-cutover.js -r ./startup-cams-patch.js -r ./cams-current-fixes.js -r ./no-reload-admin-loader.js -r ./quarter-actions-loader.js session-store-patch.js",
    "dev": "node -r ./qr-management-server.js -r ./resident-services-server.js -r ./admin-applications-loader.js -r ./firebase-integration-server.js -r ./firebase-all-routes.js -r ./firebase-route-priority.js -r ./firebase-qr-cutover.js -r ./cams-final-fixes.js -r ./resident-workforce-cutover.js -r ./resident-complaint-workforce-cutover.js -r ./startup-cams-patch.js -r ./cams-current-fixes.js -r ./no-reload-admin-loader.js -r ./quarter-actions-loader.js --watch session-store-patch.js",
    "firestore:migrate": "node scripts/migrate-sqlite-to-firestore.js",
    "test": "node tests/api-test.js"
  },
  "dependencies": {
    "@dataconnect/admin-generated": "file:src/dataconnect-admin-generated",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "better-sqlite3": "^11.8.1",
    "better-sqlite3-session-store": "^0.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0"
  }
}